run_game :: proc(fn: string) {

	nes_state := system.init_nes(fn)

	rl.InitWindow(320, 320, "Odin NES")
	defer rl.CloseWindow()

	rl.SetTargetFPS(60)

	run(&nes_state)
}
main :: proc() {
	//test_snake_game()

	context.logger = log.create_console_logger()

	when ODIN_DEBUG {
		debug6502()
	} else {
		run_game("games/snake.nes")
	}
}
